# AIO front proxy. Serves the SPA, reverse-proxies the API to uvicorn on
# loopback, and (when AIO_SITE_ADDRESS is a domain) provisions a Let's Encrypt
# certificate automatically. The entrypoint sets AIO_SITE_ADDRESS to the
# domain, or ":80" for plain HTTP. Cert/state storage is XDG_DATA_HOME
# (/app/data), set on the Caddy program so certs survive a container recreate.

{
	# No runtime reconfiguration needed; keeps the admin API off localhost:2019.
	admin off

	# Automatic HTTPS. When AIO_SITE_ADDRESS is a domain, Caddy provisions and
	# renews a certificate on its own - the reason this image uses Caddy. The
	# ACME endpoint (AIO_ACME_CA) and optional contact email (AIO_ACME_EMAIL)
	# are rendered by the entrypoint into acme.conf, so an unset email is simply
	# omitted rather than emitting an empty (and invalid) `email` directive.
	import /etc/caddy/acme.conf
}

{$AIO_SITE_ADDRESS::80} {
	# Compress everything EXCEPT the realtime SSE stream. Compressing a live
	# text/event-stream buffers it into compressible blocks, so a client
	# (Home Assistant, Node-RED) stalls for seconds on connect before the
	# initial snapshot arrives. Note the app also sends X-Accel-Buffering: no,
	# but that is an nginx convention and does nothing in Caddy, so the stream
	# must be excluded here explicitly.
	@compressible not path /v1/fronts/stream
	encode @compressible zstd gzip

	# Never write these paths to an access log. A share link's token IS the
	# capability and it lives in the path (/s/{token} for the page,
	# /v1/public/shared/{token}/... for the API calls it makes), and a public
	# file URL carries the owner's account id in the path with a live signed
	# token in the query - so an ordinary logged request line is a working key
	# to somebody's profile, sitting in a file that outlives rotating the link.
	# Caddy writes no access log unless one is configured, so this changes
	# nothing today; it is here so that adding `log` to this file later - or an
	# operator adding one downstream - cannot quietly start recording them.
	# Sheaf's own access-log filter already redacts the same three.
	@secret_urls path /s/* /v1/public/shared/* /v1/public/files/*
	log_skip @secret_urls

	# Realtime SSE stream: flush each event straight through with no buffering.
	# reverse_proxy already auto-streams text/event-stream, but pin it so a
	# future default can't reintroduce the stall. Must precede @backend below,
	# since /v1/fronts/stream also matches /v1/* (handle blocks are first-match).
	handle /v1/fronts/stream {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}

	# API + health check -> the backend on loopback. /metrics is deliberately
	# NOT proxied: it is unauthenticated and stays in-container.
	#
	# security.txt is in here by exact path, not as /.well-known/*. The backend
	# serves RFC 9116 at both /.well-known/security.txt and /security.txt, and
	# without these two entries the request fell through to the SPA handler below
	# and a researcher looking for it got the web app's index.html. Matched
	# exactly on purpose: /.well-known/* as a prefix would also capture
	# /.well-known/acme-challenge/*, and that belongs to Caddy's own certificate
	# issuance, which is the entire reason this image uses Caddy.
	@backend path /v1/* /health /.well-known/security.txt /security.txt
	handle @backend {
		reverse_proxy 127.0.0.1:8000
	}

	# Link-unfurl crawlers on a public profile (/p/) or share link (/s/) -> the
	# backend, which renders a small HTML document carrying that URL's Open Graph
	# tags. Everybody else falls through to the SPA handler below and gets the
	# app exactly as before.
	#
	# Crawlers do not run JavaScript, so a single-page app cannot answer them: the
	# static shell's tags are all they ever see, which is one generic card for
	# every URL on the instance. The per-URL card therefore has to be rendered
	# server-side, and this is the split that routes to it.
	#
	# Matching on User-Agent rather than sending all of /p/ and /s/ to the backend
	# is deliberate, and it fails in the safe direction three ways over: a crawler
	# this list misses gets the generic static card (which is the safe answer, not
	# a broken one); a real visitor is never served by the preview code, so there
	# is no server-rendered copy of the app to drift from the real one; and if the
	# backend is down, profiles still load for people.
	#
	# Whether a given profile gets a RICH card (system name, avatar, description
	# snippet) or the generic one is the profile owner's per-view setting, decided
	# in the backend. Nothing here makes that choice, and an unlisted /s/ link is
	# refused a rich card regardless.
	#
	# The header set for these responses comes from the backend itself (noindex,
	# a `default-src 'none'` CSP, no-referrer), NOT from the @profiles block
	# below: this handler answers the request, so that block never runs for it.
	@preview {
		path /p/* /s/*
		header_regexp User-Agent (?i)(discordbot|facebookexternalhit|facebot|twitterbot|slackbot|telegrambot|whatsapp|linkedinbot|skypeuripreview|redditbot|mastodon|bluesky|cardyb|synapse|iframely|embedly|vkshare|pinterest|applebot|googlebot|bingbot|duckduckbot|qwantify|tumblr|flipboard|snapchat|viber|nuzzel|opengraph|metauri)
	}
	handle @preview {
		reverse_proxy 127.0.0.1:8000
	}

	# Everything else -> the single-page app. Sheaf only sets security headers
	# on its own /v1/* responses, so the SPA document needs them here (mirrors
	# the reverse-proxy examples in docs/SELFHOSTING.md).
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
		# Public profiles (/p/) and share links (/s/) get their own header set,
		# and the two matchers are mutually exclusive on purpose: `header` sets,
		# so if both handlers matched a request the last one Caddy ran would
		# silently win, and the adapter does not order them by where they sit
		# in this file. One request, one header handler, no precedence puzzle.
		# `header` is ordered before try_files, so the matcher sees the original
		# path, not /index.html.
		@profiles path /p/* /s/*
		@app not path /p/* /s/*
		header @app {
			X-Frame-Options "DENY"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		}

		# Same headers, two differences. X-Robots-Tag: these are the only pages
		# a crawler can reach - the rest of the app is behind auth - and they
		# are meant for sharing, not for search results. The pages set a
		# noindex meta tag themselves; the header covers a crawler that indexes
		# on headers before running the SPA. And img-src drops https: and blob:,
		# because these pages are read by anonymous visitors: the server already
		# withholds external images from them, and if that ever regressed the
		# browser refuses the fetch rather than announcing the visitor's address
		# to a host the profile owner chose. Hosted uploads use the dedicated
		# same-origin /v1/public/files route even when normal image serving uses
		# S3 redirects or a CDN.
		header @profiles {
			X-Frame-Options "DENY"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			X-Robots-Tag "noindex, nofollow"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		}
	}
}
